root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,xml,csproj,props,slnx,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- Namespaces and usings ---
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0005.severity = warning              # unnecessary usings
dotnet_diagnostic.IDE0161.severity = warning              # file-scoped namespace

# --- var ---
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_diagnostic.IDE0007.severity = suggestion

# --- Braces: optional for single-line statements ---
csharp_prefer_braces = when_multiline:warning
dotnet_diagnostic.IDE0011.severity = warning

# --- Modern C# ---
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning              # make field readonly
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_diagnostic.IDE0049.severity = warning              # int not Int32
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.IDE0055.severity = warning              # formatting

# --- Naming ---
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = i_prefix
dotnet_naming_rule.interfaces_i_prefix.severity = warning

dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning

# Constants and static readonly fields take precedence over the general private field rule.
dotnet_naming_rule.constants_pascal.priority = 1
dotnet_naming_rule.static_readonly_pascal.priority = 2
dotnet_naming_rule.private_fields_underscore.priority = 3
dotnet_diagnostic.IDE1006.severity = warning              # enforce naming rules in build

[tests/**.cs]
# Test names use underscores: Method_Scenario_ExpectedResult.
dotnet_diagnostic.CA1707.severity = none
# Test classes are discovered by reflection and don't need to be internal.
dotnet_diagnostic.CA1515.severity = none

[*.{cmd,bat}]
end_of_line = crlf

@host = http://localhost:5055

### Create a calendar
# @name calendar
POST {{host}}/api/calendars
Content-Type: application/json

{
  "name": "Work",
  "owner": "rene"
}

### List calendars for an owner
GET {{host}}/api/calendars?owner=rene

### Rename the calendar
PUT {{host}}/api/calendars/{{calendar.response.body.$.id}}
Content-Type: application/json

{
  "name": "Job"
}

### Create an event in the calendar
# @name created
POST {{host}}/api/calendars/{{calendar.response.body.$.id}}/events
Content-Type: application/json

{
  "title": "Standup",
  "description": "Daily sync",
  "startDate": "2026-11-18T09:00:00+01:00",
  "endDate": "2026-11-18T09:15:00+01:00"
}

### Create a weekly meeting (every Monday, 10 times)
POST {{host}}/api/calendars/{{calendar.response.body.$.id}}/events
Content-Type: application/json

{
  "title": "Team meeting",
  "startDate": "2026-11-16T10:00:00+01:00",
  "endDate": "2026-11-16T11:00:00+01:00",
  "recurrence": {
    "frequency": 2,
    "interval": 1,
    "count": 10
  }
}

### List events in a time range (recurring events appear once per occurrence)
GET {{host}}/api/calendars/{{calendar.response.body.$.id}}/events?from=2026-11-18T00:00:00Z&to=2026-11-19T00:00:00Z

### Get the event
GET {{host}}/api/calendars/{{calendar.response.body.$.id}}/events/{{created.response.body.$.id}}

### Move the event
PUT {{host}}/api/calendars/{{calendar.response.body.$.id}}/events/{{created.response.body.$.id}}
Content-Type: application/json

{
  "title": "Standup (moved)",
  "startDate": "2026-11-18T10:00:00+01:00",
  "endDate": "2026-11-18T10:15:00+01:00"
}

### Delete the event
DELETE {{host}}/api/calendars/{{calendar.response.body.$.id}}/events/{{created.response.body.$.id}}

### Delete the calendar (also deletes its events)
DELETE {{host}}/api/calendars/{{calendar.response.body.$.id}}
